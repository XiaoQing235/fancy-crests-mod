{
	"schemaVersion": 1,
	"id": "fancycrests",
	"version": "${version}",
	"name": "Fancy Crests (Custom Names)",
	"description": "Server-side crests mod: custom prefixes, suffixes and nicknames visible to vanilla clients.",
	"authors": [
		"Fancy Crests Contributors"
	],
	"license": "Apache-2.0",
	"icon": "assets/fancycrests/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": [
			{
				"adapter": "kotlin",
				"value": "dev.fancycrests.FancyCrestsMod"
			}
		]
	},
	"mixins": [
		"fancycrests.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"fabric-api": ">=0.161.0",
		"fabric-language-kotlin": ">=1.14.2+kotlin.2.4.21",
		"minecraft": "~26.2",
		"java": ">=25"
	}
}
